# ============================================
# MovieTracker - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to GitHub.
# ============================================

# Supabase Project URL & Anon Public Key (Frontend & Functions)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Used for Bot, Cron & Webhooks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Telegram Bot Credentials (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_USERNAME=movietracker_bot

# Alert checking frequency in seconds (default: 60)
CHECK_INTERVAL_SECONDS=60
